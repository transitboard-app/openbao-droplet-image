# Build outputs.
out/

# The build's working directory: the assembled overlay, the staged payload, and the scratch copy the
# boot test runs against. Everything in here is regenerated by `mise run build` and none of it is an
# input. `mise run clean` removes it.
.build/

# The verified OpenBao binary, 186 MiB and reproducible from OPENBAO_IMAGE at any time. Cached rather
# than committed: mise run fetch-bao refuses to use a copy whose checksum does not match BAO_SHA256, so
# there is nothing a committed copy would protect that the pin does not already.
.cache/
