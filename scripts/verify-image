#!/bin/sh
# Offline assertions against a built image: mounts the qcow2 through qemu-nbd and checks everything that
# can be checked without booting. Needs root, for the same reason the build does.
#
# The division of labour is deliberate: this catches build mistakes in seconds, so a boot test is spent
# only on the things that genuinely need a running kernel -- whether BIOS boot works, whether the
# initramfs carries virtio, whether AppArmor came up enforcing.
set -eu

# The image to check, passed by the `verify` mise task. Its dependencies (qemu-nbd, sfdisk, losetup)
# come from [bootstrap.packages] rather than being installed here -- this runs natively on the build
# host now, not inside a container it could apk into.
IMAGE="${1:?usage: verify-image <image.qcow2>}"
test -f "$IMAGE" || { echo "no image at $IMAGE; run mise run build" >&2; exit 1; }

fail=0
check() {
	if eval "$2" >/dev/null 2>&1; then
		printf '  ok    %s\n' "$1"
	else
		printf '  FAIL  %s\n' "$1"
		fail=1
	fi
}

echo "==> image container"
check "qcow2 format" "qemu-img info '$IMAGE' | grep -q 'file format: qcow2'"

modprobe nbd max_part=8 2>/dev/null || true
nbd=/dev/nbd0
qemu-nbd --connect="$nbd" --format=qcow2 "$IMAGE"
# `losetup -d "$loop"`, never `losetup -D`. The second is "detach all", not "detach mine", and this
# script runs as root on a CI runner and on developer machines -- it would reach loop devices it did not
# create and has no business touching. $loop is empty until it is set below, and `losetup -d` with no
# argument is a usage error rather than a wildcard, so the trap is safe from the moment it is installed.
loop=""
trap 'umount /mnt/img 2>/dev/null || true; if [ -n "$loop" ]; then losetup -d "$loop" 2>/dev/null || true; fi; qemu-nbd --disconnect "$nbd" >/dev/null 2>&1 || true' EXIT
sleep 2

# DigitalOcean rejects an image with no partition table, and alpine-make-vm-image writes the filesystem
# straight onto the disk unless --partition is passed -- which boots fine under QEMU and fails at
# import. Checked against the connected block device rather than the image file, because neither fdisk
# nor sfdisk can read a qcow2: an earlier version of this check ran against the path and reported a
# failure for an image that was correct.
check "has a GPT partition table" "sfdisk -l '$nbd' 2>/dev/null | grep -q 'Disklabel type: gpt'"

# /dev/nbd0p1 is deliberately not used. Partition scanning for nbd is a module load-time parameter, so
# on a host where something has already loaded nbd without max_part the partition devices never appear
# and there is no way to ask for them afterwards. Reading the partition's start sector and mounting at
# that offset works either way and depends on nothing outside this script.
start_sector="$(sfdisk --json "$nbd" | tr -d ' "' | sed -n 's/^start:\([0-9]*\),*$/\1/p' | head -1)"
test -n "$start_sector" || { echo "could not read the root partition's start sector" >&2; exit 1; }
loop="$(losetup --find --show --read-only --offset "$((start_sector * 512))" "$nbd")"

mkdir -p /mnt/img
mount -o ro "$loop" /mnt/img
R=/mnt/img

# The package record and the build manifest, copied out while the image happens to be mounted. Between
# them they are the whole description of what this artifact is -- what is installed, and what built it --
# and once apk is removed from the image there is nothing inside that can be asked. They belong beside
# the artifact rather than only within it: the release notes publish both, so somebody deciding whether
# to boot this image can read them without downloading and mounting it first.
cp "$R/etc/openbao-appliance-packages" "$(dirname "$IMAGE")/packages.txt" 2>/dev/null || true
cp "$R/etc/openbao-appliance-release" "$(dirname "$IMAGE")/release.txt" 2>/dev/null || true

echo "==> boot"
# The check this whole image most depends on. AppArmor is compiled into linux-virt but left out of
# CONFIG_LSM, so without both of these on the kernel command line the profile below loads and confines
# nothing, with no error anywhere.
check "apparmor=1 on cmdline"     "grep -q 'apparmor=1' $R/boot/extlinux.conf"
check "apparmor in lsm= list"     "grep -qE 'lsm=[^ ]*apparmor' $R/boot/extlinux.conf"
# Asserted because setup.sh rewrites the kernel command line, and the obvious way to do that
# (replacing default_kernel_opts outright) drops the console= that --serial-console added.
check "serial console on cmdline" "grep -qE 'console=ttyS0' $R/boot/extlinux.conf"
check "kernel present"            "ls $R/boot/vmlinuz-virt"
check "initramfs present"         "ls $R/boot/initramfs-virt"
check "memory zeroing enabled"    "grep -q 'init_on_free=1' $R/boot/extlinux.conf"
# Both boot-tested before being enabled, and both silently absent if the command-line edit above ever
# drops them -- the same failure mode as apparmor=1, which is why they are asserted the same way.
check "kernel lockdown enabled"   "grep -q 'lockdown=integrity' $R/boot/extlinux.conf"
check "module signatures forced"  "grep -q 'module.sig_enforce=1' $R/boot/extlinux.conf"
# Pure description of the machine, useful only to somebody standing on it: the kernel's build
# configuration and the pre-hardening boot configuration.
check "no kernel config"          "! ls $R/boot/config-* 2>/dev/null | grep -q ."
check "no previous extlinux conf" "! test -e $R/boot/extlinux.conf.old"

echo "==> OpenBao"
check "binary installed"          "test -x $R/usr/sbin/bao"
check "binary is root-owned"      "[ \"\$(stat -c %u $R/usr/sbin/bao)\" = 0 ]"
check "storage fragment present"  "test -f $R/etc/openbao/config.d/00-storage.hcl"
check "listener fragment present" "test -f $R/etc/openbao/config.d/10-listener.hcl"
check "audit fragment present"    "test -f $R/etc/openbao/config.d/20-audit.hcl"
# Three files rather than one, so each default can be replaced or deleted on its own. `listener` and
# `audit` APPEND across fragments rather than overriding -- measured against 2.6.1, a second audit block
# enables a second device -- so a combined file would make the image's choices unremovable.
check "fragments are separate"    "! test -e $R/etc/openbao/config.d/00-appliance.hcl"
# The single-file config was replaced by a directory. Asserted as an absence too, because a file left at
# the old path would not be loaded and nothing else would say so -- the server would start on the
# fragments it did find and quietly serve a configuration nobody wrote.
check "no config at the old path" "! test -e $R/etc/openbao/openbao.hcl"
check "service loads /etc frags"  "grep -q 'config=/etc/openbao/config.d' $R/etc/init.d/openbao"
check "service loads user_data"   "grep -q 'config=/run/openbao/config.d' $R/etc/init.d/openbao"
# Not a hardening preference any more but a boot gate: OpenBao 2.x rejects `disable_mlock = false` as a
# fatal configuration error, and supervise-daemon respawns the failure until it gives up. Absent is the
# only spelling that both loads and tells the truth. See the note in the config itself.
check "disable_mlock absent"      "! grep -rqE '^[^#]*disable_mlock' $R/etc/openbao/config.d/"
check "audit device declared"     "grep -q 'audit \"file\"' $R/etc/openbao/config.d/20-audit.hcl"
# The image must ship no seal stanza in any fragment, so an unconfigured node uses Shamir and starts.
# Shipping one would make every node without a key file refuse to load -- turning the default case into a
# failure -- and would rule out the transit and KMS seals, which have no key file to give. It would also
# mandate the WEAKEST at-rest option: a static key lives on the disk it decrypts, where Shamir shares
# never touch the node at all. Auto-unseal is opted into with a fragment; README.md has the trade.
check "no seal stanza shipped"    "! grep -rqE '^[[:space:]]*seal[[:space:]]' $R/etc/openbao/config.d/"
# Off unless asked. The one setting here that was pure preference rather than something the appliance
# needs, and an appliance shipping no shell should not serve a web console by default.
check "ui not enabled"            "! grep -rqE '^[[:space:]]*ui[[:space:]]*=[[:space:]]*true' $R/etc/openbao/config.d/"
# Same ownership argument as the TLS directory below: root owns it so a confined root can traverse it
# without a capability, and the openbao group reads it so the server can.
check "config dir is root-owned"  "[ \"\$(stat -c %u $R/etc/openbao/config.d)\" = 0 ]"
check "config dir group is 65532" "[ \"\$(stat -c %g $R/etc/openbao/config.d)\" = 65532 ]"
check "config dir is 0750"        "[ \"\$(stat -c %a $R/etc/openbao/config.d)\" = 750 ]"
check "seal dir present"          "test -d $R/etc/openbao/seal"
check "seal dir is 0750"          "[ \"\$(stat -c %a $R/etc/openbao/seal)\" = 750 ]"
# Shipping a key would make every Droplet booting this image share one, and it is a public image.
check "no seal key shipped"       "! test -e $R/etc/openbao/seal/key"
check "openbao user is 65532"     "grep -q '^openbao:x:65532:' $R/etc/passwd"
check "openbao user has nologin"  "grep '^openbao:' $R/etc/passwd | grep -q nologin"
# **No TLS directory on the boot disk.** It moved to /var/lib/openbao/tls on the attached volume so a
# replacement Droplet reattaches it rather than an operator copying a key back -- see D23. Leaving the old
# directory behind would be worse than deleting it: an `scp` to the old path would succeed and the node
# would still refuse to start, naming a directory that looked correct.
check "no tls dir on boot disk"   "! test -e $R/etc/openbao/tls"
check "listener reads the volume" "grep -q '/var/lib/openbao/tls/server.crt' $R/etc/openbao/config.d/10-listener.hcl"
# tls_cert_file present, asserted as a value rather than assumed from the path check above, because its
# ABSENCE is not "no TLS" -- OpenBao 2.6.1 reads an empty tls_cert_file as "use ACME", aims at Let's
# Encrypt production and takes a temporary bind on port 80 for the challenge. Measured. A node reached
# over a private address can never complete it, so the failure is a retry loop rather than a refusal.
check "listener sets tls_cert_file" "grep -qE '^[[:space:]]*tls_cert_file[[:space:]]*=' $R/etc/openbao/config.d/10-listener.hcl"
check "no acme shipped"           "! grep -rqE '^[[:space:]]*tls_acme_' $R/etc/openbao/config.d/"
# The gate reads the configuration rather than a path compiled into the service, which is what lets a
# node use ACME, tls_disable or a certificate somewhere else without the service refusing to start over
# files its operator deliberately did not create. Asserted as the absence of the old hard-coded test as
# well as the presence of the new lookup: leaving both in place would gate on the shipped path anyway.
check "gate reads the config"     "grep -q 'config_values tls_cert_file' $R/etc/init.d/openbao"
check "gate is not hard-coded"    "! grep -qE '^[[:space:]]*if \[ ! -f /var/lib/openbao/tls/server.crt' $R/etc/init.d/openbao"
# The gate has to run after user_data has been turned into a fragment, or a listener supplied that way
# is invisible to it. Ordering inside a shell function is not otherwise checkable offline.
check "user_data read before gate" "[ \"\$(grep -n 'Loaded user_data as a configuration fragment' $R/etc/init.d/openbao | cut -d: -f1)\" -lt \"\$(grep -n 'names TLS material that is not there' $R/etc/init.d/openbao | cut -d: -f1)\" ]"
# root:openbao 0750, not 65532:65532 0700, and this is now the mountpoint rather than a directory under
# /etc. Owned by the uid OpenBao runs as, it could not be traversed by a confined root -- the AppArmor
# profile attaches to /usr/sbin/bao and grants no capability -- which broke every operator command on the
# node and is the reason TLS can live on this volume at all. Raft gets a subdirectory it owns outright.
check "volume mount is root-owned" "[ \"\$(stat -c %u $R/var/lib/openbao)\" = 0 ]"
check "volume mount group is 65532" "[ \"\$(stat -c %g $R/var/lib/openbao)\" = 65532 ]"
check "volume mount is 0750"      "[ \"\$(stat -c %a $R/var/lib/openbao)\" = 750 ]"
check "storage is a subdirectory" "grep -q 'path = \"/var/lib/openbao/data\"' $R/etc/openbao/config.d/00-storage.hcl"

echo "==> confinement"
check "apparmor profile present"  "test -f $R/etc/apparmor.d/openbao"
check "abstractions installed"    "test -f $R/etc/apparmor.d/abstractions/base"
check "no_new_privs requested"    "grep -q 'no_new_privs=\"yes\"' $R/etc/init.d/openbao"
# Inverted from what these two asserted before. The image granted CAP_IPC_LOCK ambiently and the profile
# allowed it, both so OpenBao could mlock -- until a live Droplet showed OpenBao 2.x has dropped mlock
# support, leaving a network service holding a denial-of-service primitive it has no code to use. These
# now assert the grant has not crept back.
check "no capability granted"     "! grep -qE '^[^#]*capability ' $R/etc/apparmor.d/openbao"
check "no ambient capabilities"   "! grep -qE '^[^#]*capabilities=' $R/etc/init.d/openbao"

# The Raft volume is found through sysfs, never through /dev/disk/by-id. DigitalOcean documents the
# by-id path and it is real on their udev-based images, but this appliance runs mdev, which leaves that
# directory empty -- so the documented glob matched nothing on a Droplet whose volume was attached and
# healthy, and OpenBao refused to start. Asserted here because the correct version is the less obvious
# one and reads like a mistake.
# The service must survive its own crashes. Alpine's inherited default gives up after five in thirty
# minutes, which on a single node with no quorum is the store gone until somebody notices.
check "openbao respawns forever"  "grep -q '^respawn_max=0' $R/etc/init.d/openbao"
# The metadata service answers some time after the network is up, and that wait cannot be an OpenRC
# dependency because the endpoint is not a service on this machine. It is owned by one service that
# everything else declares `need` on, rather than by a retry loop per consumer -- which is how openbao
# ended up with no retry at all while cloud-ssh-keys had fifteen.
check "one place retries IMDS"    "grep -q 'IMDS_ATTEMPTS' $R/etc/init.d/metadata"
check "openbao needs metadata"    "grep -qE '^[[:space:]]*need .*metadata' $R/etc/init.d/openbao"
check "openbao needs its volume"  "grep -qE '^[[:space:]]*need .*openbao-volume' $R/etc/init.d/openbao"
check "ssh keys need metadata"    "grep -qE '^[[:space:]]*need metadata' $R/etc/init.d/cloud-ssh-keys"
# No consumer fetches for itself. A second copy of the retry logic is how the two diverged.
check "no IMDS fetch in openbao"  "! grep -q '169.254.169.254' $R/etc/init.d/openbao"
check "no IMDS fetch in ssh keys" "! grep -q '169.254.169.254' $R/etc/init.d/cloud-ssh-keys"
check "volume found via sysfs"    "grep -q '/sys/block/sd\\*' $R/etc/init.d/openbao-volume"
# Anchored past any `#`, because the comment above that code names the by-id path in order to explain
# why it is not used -- and the first version of this check failed on that comment.
check "no by-id volume glob"      "! grep -qE '^[^#]*disk/by-id' $R/etc/init.d/openbao-volume"

echo "==> attack surface"
# Measured rather than asserted: these are the numbers that justify the appliance over a Debian node,
# and they should be visible on every build rather than quoted from a conversation.
# awk rather than `grep -c`, which exits non-zero on a count of zero and made the `|| echo 0` fallback
# fire on top of its own output -- printing "0" twice and hiding that the record was empty.
packages="$(awk '!/^[[:space:]]*#/ && NF' "$R/etc/openbao-appliance-packages" 2>/dev/null | wc -l)"
setuid="$(find $R -xdev -type f \( -perm -4000 -o -perm -2000 \) 2>/dev/null | wc -l)"
echo "  packages installed: $packages"
echo "  setuid/setgid binaries: $setuid"
check "no package manager"        "! test -e $R/sbin/apk"
# The record is the only description of what is on a node with no package manager. An empty one is a
# build failure, not a cosmetic gap.
check "package record populated"  "[ \"$packages\" -gt 50 ]"
check "no setuid binaries"        "[ \"$setuid\" -eq 0 ]"
check "no interpreters"           "! ls $R/usr/bin/python3* $R/usr/bin/perl $R/usr/bin/ruby $R/usr/bin/lua* 2>/dev/null | grep -q ."
# The scripts an interpreter would run, checked separately because the check above looks for the
# interpreter. syslinux shipped /usr/bin/isohybrid.pl, which was inert only because no perl was
# installed -- an argument that stops holding the moment anything pulls one in.
check "no interpreter scripts"    "! ls $R/usr/bin/*.pl $R/usr/bin/*.py $R/usr/sbin/*.pl $R/usr/sbin/*.py 2>/dev/null | grep -q ."
# Python's dependency closure, orphaned when its files were removed. libstdc++ is deliberately absent
# from this check: apparmor_parser links it.
check "no orphaned sqlite"        "! ls $R/usr/lib/libsqlite3.so* 2>/dev/null | grep -q ."
check "no orphaned mpdec"         "! ls $R/usr/lib/libmpdec* 2>/dev/null | grep -q ."
# A tool for granting file capabilities and a tool for manipulating capability sets, on a machine whose
# premise is that nothing holds a capability. They arrived with libcap-utils, which was justified by a
# self-check that no longer uses it.
check "no capability tools"       "! ls $R/usr/sbin/setcap $R/usr/sbin/capsh $R/usr/sbin/getpcaps 2>/dev/null | grep -q ."
# Symbols on a host holding unsealed key material help an attacker more than an operator.
check "bao is stripped"           "! readelf -S $R/usr/sbin/bao 2>/dev/null | grep -q '\.symtab'"
check "binary provenance kept"    "test -s $R/etc/openbao-binary-provenance"
# The provenance file records the checksum of the binary that was staged. This is the only place it is
# compared against the binary that actually SHIPPED -- without it the file is a claim written next to
# the thing it describes rather than a fact about it, which is the difference between provenance and a
# label. It also catches a stage directory reused across builds.
check "provenance matches bao"    "grep -q \"stripped \$(sha256sum $R/usr/sbin/bao | cut -d' ' -f1)\" $R/etc/openbao-binary-provenance"
# What built this image. For an artifact other people download and boot, "which commit of the recipe is
# this" has no answer outside the image itself.
check "release manifest kept"     "test -s $R/etc/openbao-appliance-release"
check "manifest names a commit"   "grep -q '^source-commit ' $R/etc/openbao-appliance-release"
check "manifest names the branch" "grep -q '^alpine-branch ' $R/etc/openbao-appliance-release"
check "no kernel symbol map"      "! ls $R/boot/System.map-* 2>/dev/null | grep -q ."
check "no syslinux payload"       "! test -d $R/usr/share/syslinux"
# The bootloader INSTALLER, distinct from the payload above. extlinux is already written to this disk,
# so what is left is a tool for writing a bootloader onto one, plus a FAT editor and an ISO rewriter.
check "no bootloader installer"   "! ls $R/sbin/extlinux $R/usr/bin/syslinux $R/usr/bin/isohybrid* $R/usr/bin/mtools 2>/dev/null | grep -q ."
# mkinitfs exists to build the initramfs and has built it. Nothing on a node with no package manager
# updates a kernel, so nothing regenerates one. It is also what put a disk-encryption and device-mapper
# stack on an appliance that mounts one plain ext4 filesystem: nlplug-findfs links libcryptsetup.
check "no initramfs toolchain"    "! ls $R/sbin/mkinitfs $R/sbin/nlplug-findfs 2>/dev/null | grep -q ."
check "no cryptsetup stack"       "! ls $R/usr/lib/libcryptsetup.so* $R/usr/lib/libdevmapper.so* 2>/dev/null | grep -q ."
# A raw ext2/3/4 editor reads and writes the Raft volume's blocks around every permission on them, and
# around the AppArmor profile that stops OpenBao itself doing it. resize2fs is in the same subpackage
# and is genuinely needed, which is why this is a check on the tools rather than on the package.
check "no raw filesystem editor"  "! ls $R/usr/sbin/debugfs $R/usr/sbin/e2image $R/usr/sbin/badblocks 2>/dev/null | grep -q ."
check "resize2fs kept"            "test -x $R/usr/sbin/resize2fs"
# Every SSH session this node takes part in is inbound: the tunnels are `ssh -L` from an operator's
# machine. The client suite has no caller here and is 2.2 MiB of it.
check "no ssh client"             "! ls $R/usr/bin/ssh $R/usr/bin/scp $R/usr/bin/sftp $R/usr/bin/ssh-agent $R/usr/bin/ssh-keyscan 2>/dev/null | grep -q ."
# ...but scp INTO the node is the documented way TLS material arrives, and OpenSSH 9 runs it over SFTP.
check "sftp subsystem present"    "test -x $R/usr/lib/ssh/sftp-server"
check "ssh-keygen kept"           "test -x $R/usr/bin/ssh-keygen"
# tc is a traffic-shaping language and libxtables is linked only by it. `ip` comes from
# iproute2-minimal, so `ip route replace` is unaffected by their absence.
check "no traffic control"        "! ls $R/sbin/tc $R/usr/lib/libxtables.so* 2>/dev/null | grep -q ."
check "ip route tool kept"        "test -x $R/sbin/ip"
# Python's dependency closure. These outlived the interpreter because the removal listed two libraries
# and stopped; nothing in the image links any of them.
check "no orphaned python libs"   "! ls $R/usr/lib/libffi.so* $R/usr/lib/libgdbm* $R/usr/lib/libpanelw.so* $R/usr/lib/libreadline.so* $R/usr/lib/libexpat.so* 2>/dev/null | grep -q ."
# Removing /sbin/apk and leaving the library that installs packages behind is half the job.
check "no apk library"            "! ls $R/usr/lib/libapk.so* 2>/dev/null | grep -q ."
check "chronyd is client-only"    "grep -q '^port 0' $R/etc/chrony/conf.d/10-appliance.conf"
# The check that would have caught an unreachable node. Empty CLOUD_USER makes tiny-cloud skip installing
# the SSH keys DigitalOcean injects, leaving a Droplet that boots, runs sshd, and admits nobody.
check "cloud user is root"        "grep -q '^CLOUD_USER=root' $R/etc/tiny-cloud.conf"
# Reachability of this node cannot depend on tiny-cloud, which installs no keys at all when CLOUD_USER
# is unset and reports it only as an info line in the system log.
check "own key installer present" "test -x $R/etc/init.d/cloud-ssh-keys"
# The check that would have caught a node which boots, answers on port 22, and installs no keys: nothing
# provided `net`, so every service declaring `need net` never ran.
check "net.eth0 enabled"          "test -L $R/etc/runlevels/default/net.eth0"
check "net.eth1 enabled"          "test -L $R/etc/runlevels/default/net.eth1"
check "net.lo enabled at boot"    "test -L $R/etc/runlevels/boot/net.lo"
# OpenBao advertises its private address and the firewall admits 8200 from nowhere else.
check "private interface defined" "grep -q '^iface eth1 inet dhcp' $R/etc/network/interfaces"
# The hook glob points at a directory that does not exist, so ifup fails on an interface whose DHCP
# lease succeeded -- and being trailing lines, they bind to the LAST stanza, which is eth1.
check "no dangling ifup hooks"    "! grep -q 'if-post-up.d\|if-post-down.d' $R/etc/network/interfaces"
# Without this, a Droplet with no VPC interface leaves `net` unsatisfied and nothing that needs it runs.
check "net deps are not strict"   "grep -q '^rc_depend_strict=\"NO\"' $R/etc/rc.conf"
# OpenRC serialises the whole boot by default, so services with no relationship to each other waited for
# each other. Measured on a steady-state reboot: SSH-ready 52s to 42s, OpenBao listening 60s to 48s.
# Safe only because this image's dependencies are declared rather than implied by start order.
check "services start parallel"   "grep -q '^rc_parallel=\"YES\"' $R/etc/rc.conf"
# `*` specifically, never `!`. The previous version of this check accepted either and therefore passed
# on an image whose every Droplet refused the operator's key: `!` marks the account locked, and Alpine's
# PAM-less sshd refuses a locked account before it reads authorized_keys.
check "root has no password"      "grep -q '^root:\\*:' $R/etc/shadow"
check "root is NOT locked"        "! grep -q '^root:!' $R/etc/shadow"
# The artifacts of the `debug` build that used to exist here, kept as assertions after the build path
# itself was removed. They no longer guard against releasing the wrong file -- there is no longer a way
# to produce one -- they guard against somebody adding the capability back.
check "no debug marker"           "! test -e $R/etc/APPLIANCE-DEBUG"
check "no debug sshd config"      "! test -e $R/etc/ssh/sshd_config.d/00-debug.conf"
check "no password auth drop-in"  "! grep -rqi '^[[:space:]]*PasswordAuthentication[[:space:]]*yes' $R/etc/ssh/"
# No getty on any virtual terminal: no password can match, so the prompt exists only to be failed at.
check "no virtual terminal getty" "! grep -q '^tty[1-6]:' $R/etc/inittab"
check "serial console getty kept" "grep -q '^ttyS0:' $R/etc/inittab"
# Every Droplet from an image carrying a baked host key would present the same key as every other, and
# nothing anywhere would say so. Confirmed absent, and confirmed regenerated at first boot.
check "no baked ssh host keys"    "! ls $R/etc/ssh/ssh_host_* 2>/dev/null | grep -q ."

# Dangling symlinks in /bin and /sbin, which is the failure mode of removing a binary that other names
# point at. `mount` is the one that matters -- OpenRC cannot mount /run without it and gives up before
# starting anything -- but the whole directory is cheap to check and the next removal might hit
# something else. Symlinks are resolved against the image root, not the host's.
dangling="$(find $R/bin $R/sbin $R/usr/bin $R/usr/sbin -type l 2>/dev/null | while read -r l; do
	t="$(readlink "$l")"; case "$t" in /*) t="$R$t";; *) t="$(dirname "$l")/$t";; esac
	[ -e "$t" ] || echo "$l"
done)"
check "no dangling symlinks"      "[ -z \"$dangling\" ]"
[ -z "$dangling" ] || echo "$dangling" | sed "s|$R|    |"
# Resolved against the image root rather than followed. /bin/mount is a symlink to the absolute path
# /bin/bbsuid, so `test -e` on it asks about the HOST's /bin/bbsuid and answers a question nobody asked.
check "mount resolves in-image"   "test -x $R\$(readlink $R/bin/mount)"

echo "==> kernel modules"
# Attack surface before size: a filesystem or protocol parser in the kernel is a classic exploit target,
# and a module that is not on disk cannot be autoloaded by anything that provokes the kernel into
# trying. This appliance mounts ext4 and speaks TCP over virtio; everything else was removed.
modules="$(find $R/lib/modules -name '*.ko*' 2>/dev/null | wc -l)"
echo "  modules present: $modules ($(du -sh $R/lib/modules 2>/dev/null | cut -f1))"
check "no sound drivers"          "! test -d $R/lib/modules/*/kernel/sound"
check "no unused filesystems"     "! ls -d $R/lib/modules/*/kernel/fs/btrfs $R/lib/modules/*/kernel/fs/xfs $R/lib/modules/*/kernel/fs/ntfs3 2>/dev/null | grep -q ."
check "ext4 kept"                 "ls $R/lib/modules/*/kernel/fs/ext4/ext4.ko* >/dev/null 2>&1"
check "virtio_scsi kept"          "ls $R/lib/modules/*/kernel/drivers/scsi/virtio_scsi.ko* >/dev/null 2>&1"
check "virtio_blk kept"           "ls $R/lib/modules/*/kernel/drivers/block/virtio_blk.ko* >/dev/null 2>&1"
check "virtio_net kept"           "ls $R/lib/modules/*/kernel/drivers/net/virtio_net.ko* >/dev/null 2>&1"
check "no netfilter"              "! test -d $R/lib/modules/*/kernel/net/netfilter"
# Protocol families the kernel autoloads on a socket() call, which is four lines of C needing no
# privilege. A module that is not on disk cannot be autoloaded by anything.
check "no autoloadable families"  "! ls -d $R/lib/modules/*/kernel/net/key $R/lib/modules/*/kernel/net/llc $R/lib/modules/*/kernel/net/vmw_vsock $R/lib/modules/*/kernel/net/l2tp 2>/dev/null | grep -q ."
# The NVMe-over-TCP target is a network-facing block protocol server; it arrived with the deliberate
# decision to keep nvme/host for DigitalOcean's storage.
check "nvme host kept"            "test -d $R/lib/modules/*/kernel/drivers/nvme/host"
check "no nvme target"            "! test -d $R/lib/modules/*/kernel/drivers/nvme/target"
# 1.4 MiB of hypervisor that loaded itself into the secret store host, observed in lsmod on the running
# appliance.
check "no kvm"                    "! test -d $R/lib/modules/*/kernel/arch/x86/kvm"
# A Droplet's NIC is virtio. What the prune removes is drivers for hardware that cannot be attached,
# plus the encapsulation drivers -- ppp, slip, wireguard, ovpn, vxlan, macsec, tun -- each of which the
# kernel autoloads the moment something asks for that link type, and none of which has a caller here.
#
# **Asserted against the dependency closure, not against the name.** The first version of this check
# demanded that drivers/net contain nothing but virtio_net, which is wrong in the specific way that
# matters: virtio_net loads with net_failover, and an image that satisfies the naive check is one whose
# network does not come up. Both this and the prune it verifies read modules.dep, so neither can be
# right about a module while being wrong about what it needs.
kver="$(ls "$R/lib/modules" | head -1)"
netdep="$(grep -m1 '/virtio_net\.ko' "$R/lib/modules/$kver/modules.dep" 2>/dev/null || true)"
allowed=" $(printf '%s' "$netdep" | tr ':' ' ' | tr ' ' '\n' | sed 's|.*/||' | tr '\n' ' ') "
unexpected="$(find "$R/lib/modules/$kver/kernel/drivers/net" -type f -name '*.ko*' -printf '%f\n' 2>/dev/null |
	while read -r m; do case "$allowed" in *" $m "*) ;; *) echo "$m" ;; esac; done)"
check "only virtio networking"    "[ -z \"$unexpected\" ]"
[ -z "$unexpected" ] || echo "$unexpected" | sed 's/^/    unexpected: /'
# The other half of the same question, and the one the boot answers if this does not: everything
# virtio_net loads with has to still be on disk. A missing dependency is invisible offline otherwise --
# the module file is present, so every check that looks for it passes, and the node boots with no
# network, no metadata, no SSH and no OpenBao.
missing_dep=""
for path in $(printf '%s' "$netdep" | tr ':' ' '); do
	[ -f "$R/lib/modules/$kver/$path" ] || missing_dep="$missing_dep $path"
done
check "virtio_net deps present"   "[ -z \"$missing_dep\" ]"
[ -z "$missing_dep" ] || echo "    missing:$missing_dep"
# SCSI generic passes arbitrary SCSI commands straight to a device, which on this node means straight to
# the disk holding the Raft store. sr_mod is a CD-ROM driver on a machine with no optical drive.
check "no scsi passthrough"       "! ls $R/lib/modules/*/kernel/drivers/scsi/sg.ko* $R/lib/modules/*/kernel/drivers/scsi/sr_mod.ko* 2>/dev/null | grep -q ."
check "no iscsi or fc transports" "! ls -d $R/lib/modules/*/kernel/drivers/scsi/*iscsi* $R/lib/modules/*/kernel/drivers/scsi/*transport* 2>/dev/null | grep -q ."
check "virtio_scsi kept for raft" "ls $R/lib/modules/*/kernel/drivers/scsi/virtio_scsi.ko* >/dev/null 2>&1"
check "sd_mod kept for raft"      "ls $R/lib/modules/*/kernel/drivers/scsi/sd_mod.ko* >/dev/null 2>&1"

echo "==> initramfs"
# **The initramfs is generated when the kernel package is installed, which is before setup.sh runs.**
# So for as long as this image has existed, every module the build carefully removed from /lib/modules
# was still sitting in /boot/initramfs-virt -- 1.4 MiB of GPU drivers, 724 KiB of USB, RAID, HID and the
# whole filesystem tree -- and the claim "a module that is not on disk cannot be loaded" was true of the
# root filesystem and false of the boot medium beside it. setup.sh now regenerates it after pruning.
#
# Checked with cpio against the real archive rather than by grepping the compressed bytes, because a
# path that appears inside some other file would answer the wrong question.
initfs_list="$(gzip -dc "$R/boot/initramfs-virt" 2>/dev/null | cpio -it 2>/dev/null)"
check "initramfs is readable"     "[ -n \"\$(printf '%s' \"$initfs_list\" | head -c1)\" ]"
check "initramfs mounts root"     "printf '%s' \"$initfs_list\" | grep -q 'virtio_blk'"
check "initramfs has ext4"        "printf '%s' \"$initfs_list\" | grep -q 'fs/ext4'"
check "initramfs has virtio_scsi" "printf '%s' \"$initfs_list\" | grep -q 'virtio_scsi'"
check "initramfs has no gpu"      "! printf '%s' \"$initfs_list\" | grep -q 'drivers/gpu'"
check "initramfs has no usb"      "! printf '%s' \"$initfs_list\" | grep -q 'drivers/usb'"
check "initramfs has no raid"     "! printf '%s' \"$initfs_list\" | grep -q 'drivers/md'"
check "initramfs has no hid"      "! printf '%s' \"$initfs_list\" | grep -q 'drivers/hid'"
check "initramfs fs is ext4 only" "! printf '%s' \"$initfs_list\" | grep -qE 'fs/(btrfs|xfs|squashfs|f2fs|ntfs)'"
echo "  initramfs: $(( $(stat -c %s "$R/boot/initramfs-virt") / 1024 )) KiB, $(printf '%s' "$initfs_list" | grep -c '\.ko' || true) modules"

echo "==> services"
# `test -L`, not `ls`. Runlevel entries are symlinks to absolute paths (/etc/init.d/openbao), so they
# dangle whenever the image is mounted anywhere other than / -- and `ls` treats a dangling symlink as an
# error. An earlier version used `ls` and reported every service as missing on an image where all of
# them were correctly enabled.
for s in apparmor tiny-cloud-boot; do
	check "$s enabled at boot"    "test -L $R/etc/runlevels/boot/$s"
done
# sysctl is in this list because all twenty settings in 99-openbao.conf depend on it and it is enabled
# only because Alpine puts it there -- an unguarded property held by somebody else's default.
check "sysctl enabled at boot"    "test -L $R/etc/runlevels/boot/sysctl"
for s in openbao openbao-volume metadata sshd chronyd tiny-cloud-main openbao-pod-routes cloud-ssh-keys openbao-selfcheck; do
	check "$s enabled by default" "test -L $R/etc/runlevels/default/$s"
done

echo "==> logs"
# The appliance must not be able to fill its own root disk. OpenBao refuses requests when every audit
# device fails to write, and the audit device does not rotate itself -- 5.8 KiB per operation, measured,
# against a 25 GiB Droplet.
check "crond enabled by default"  "test -L $R/etc/runlevels/default/crond"
check "log rotator installed"     "test -x $R/usr/local/sbin/openbao-rotate-logs"
# test -L, not -e: this is a symlink to an absolute path, so it resolves against the HOST while the image
# is mounted here and would read as missing on an image where it is correct.
check "log rotator scheduled"     "test -L $R/etc/periodic/15min/openbao-rotate-logs"
check "cron runs the 15min set"   "grep -q 'periodic/15min' $R/etc/crontabs/root"
# Upstream's protocol for rotating an audit log the file device will not rotate itself.
check "openbao reload defined"    "grep -q 'extra_started_commands=\"reload\"' $R/etc/init.d/openbao"

echo "==> ssh"
# Turning this off is the most plausible well-intentioned change that would break operations entirely,
# so it is asserted rather than left to review.
S=$R/etc/ssh/sshd_config.d/10-appliance.conf
check "tcp forwarding allowed"    "grep -q '^AllowTcpForwarding yes' $S"
check "password auth disabled"    "grep -q '^PasswordAuthentication no' $S"
# TCP forwarding is needed and unix-socket forwarding is not; they are separate options and turning on
# the first does not turn on the second.
check "no unix socket forwarding" "grep -q '^AllowStreamLocalForwarding no' $S"
# The subsystem has to be named because the image installs openssh-sftp-server as its own package
# rather than taking the meta-package, and scp is how TLS material reaches the node.
check "sftp subsystem configured" "grep -q '^Subsystem sftp /usr/lib/ssh/sftp-server' $S"
# Which key authenticated, not merely that root did. On a node whose only account is shared, the key
# fingerprint is the only attribution there is.
check "verbose auth logging"      "grep -q '^LogLevel VERBOSE' $S"
check "startup concurrency bound" "grep -q '^MaxStartups ' $S"

echo "==> host hardening"
# Twenty-eight sysctls, of which these are the ones whose absence is silent. Checked in the file rather
# than at runtime -- openbao-selfcheck does the runtime half on a booted node.
Y=$R/etc/sysctl.d/99-openbao.conf
# The largest piece of kernel attack surface an unprivileged process can reach, and nothing here uses
# one: there is no container runtime, which is the whole reason this image exists.
check "user namespaces refused"   "grep -q '^user.max_user_namespaces=0' $Y"
check "core dumps discarded"      "grep -q '^kernel.core_pattern=|/bin/false' $Y"
check "ptrace fully restricted"   "grep -q '^kernel.yama.ptrace_scope=3' $Y"
check "symlink protection on"     "grep -q '^fs.protected_symlinks=1' $Y"
check "hardlink protection on"    "grep -q '^fs.protected_hardlinks=1' $Y"
# Loose rather than strict, deliberately: D20 routes pod traffic here whose source address belongs to
# none of this node's subnets, and strict mode drops exactly that, silently.
check "rp_filter is loose"        "grep -q '^net.ipv4.conf.all.rp_filter=2' $Y"

echo "==> operator experience"
# The image's own rule is that anything making an operator reach for -tls-skip-verify is a bug in the
# image. Nothing set BAO_CACERT, so the first command run on any node failed certificate verification
# and that flag was the documented way out of it.
check "cli env installed"         "test -f $R/etc/profile.d/openbao.sh"
check "cli env sets the ca"       "grep -q 'BAO_CACERT' $R/etc/profile.d/openbao.sh"
check "cli env reads the config"  "grep -q 'tls_client_ca_file' $R/etc/profile.d/openbao.sh"
# Never a hard-coded path: a node whose operator replaced the listener fragment or uses ACME must not
# have a stale CA forced on its CLI.
check "cli env is not hard-coded" "! grep -qE 'BAO_CACERT=[\"]?/' $R/etc/profile.d/openbao.sh"
# A running OpenBao is not a ready one: OpenRC reports `started` as soon as the process is spawned, and
# with the default Shamir seal the node comes up sealed and serving nothing after every restart. Nothing
# on the node said which, and DigitalOcean has no readiness hook to ask. The self-check reports it, at
# every boot, onto the serial console the recovery console shows.
check "readiness is reported"     "grep -q 'READY' $R/usr/local/sbin/openbao-selfcheck"
check "readiness names the api"   "grep -q 'sys/health' $R/usr/local/sbin/openbao-selfcheck"
# One Droplet with no attached volume is a legitimate arrangement, and refusing it outright is a
# lock-in rather than a safeguard. It has to be said explicitly, so it cannot be reached by accident.
check "volume opt-out supported"  "grep -q 'RAFT_DEVICE:-}\" = \"none\"' $R/etc/init.d/openbao-volume"
check "volume opt-out documented" "grep -q 'RAFT_DEVICE=\"none\"' $R/etc/conf.d/openbao-volume"

echo
if [ "$fail" -ne 0 ]; then
	echo "FAILED"
	exit 1
fi
echo "All offline checks passed. Boot it before believing any of the runtime properties:"
echo "  mise run boot"
