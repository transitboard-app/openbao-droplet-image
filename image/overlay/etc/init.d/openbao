#!/sbin/openrc-run
# shellcheck shell=sh
# shellcheck disable=SC2034  # openrc-run reads these variables out of this file; nothing here uses
# them directly, so shellcheck cannot see the consumer.
# OpenBao, supervised and confined.
#
# This replaces the systemd unit in stack/infrastructure/platform/cloud-init.yaml.tftpl. Every guard in
# that unit is reproduced here, because each one was added in response to something that actually went
# wrong; where the mechanism differs, the comment says so.

name="OpenBao"
description="OpenBao secret control plane"

command="/usr/sbin/bao"
command_args="server -config=/etc/openbao/openbao.hcl"
command_user="openbao:openbao"

supervisor="supervise-daemon"
supervise_daemon_args="--stdout /var/log/openbao/stdout.log --stderr /var/log/openbao/stderr.log"
# OpenRC's own default for a supervise-daemon service, written out rather than inherited because
# reload() below reads it and a silently different path would mean a rotated audit log never reopened.
pidfile="/run/supervise-${RC_SVCNAME}.pid"

# SIGHUP, which is how a rotated audit log gets reopened. Upstream: "Sending a SIGHUP to the OpenBao
# process will cause `file` audit devices to close and re-open their underlying file." Without this,
# /usr/local/sbin/openbao-rotate-logs renames audit.log and OpenBao keeps writing to the renamed inode --
# rotation that does not rotate, losing audit records with nothing to say so.
#
# OpenBao treats SIGHUP as a configuration reload, so this also picks up replaced TLS material without a
# restart. A reload that cannot be applied is logged and the server keeps running on what it had.
extra_started_commands="reload"

# No capabilities at all, deliberately, and the history is worth keeping because it was wrong twice.
#
# This line used to read `capabilities="^cap_ipc_lock"` -- cap_iab(3) notation putting CAP_IPC_LOCK in
# the ambient set, so it would survive the drop to uid 65532 and the exec into a non-root process. That
# mechanism works exactly as documented: a Droplet running it showed `CapAmb: 0000000000004000`.
#
# It bought nothing. **OpenBao 2.x has dropped mlock support outright.** Starting it with
# `disable_mlock = false` is a fatal configuration error in so many words:
#
#   OpenBao has dropped support for mlock. Please remove the line "disable_mlock" = false
#   from your config and disable or encrypt swap instead.
#
# So the capability was delivered to a process containing no code that could use it, and `VmLck` stayed
# at 0 on a node where every part of the grant had succeeded. Handing a long-lived network service the
# ability to lock unlimited memory -- a denial-of-service primitive -- in exchange for nothing is a
# straight loss, so it is gone.
#
# Upstream's own replacement guidance is "disable or encrypt swap", which image/setup.sh does: no swap
# is configured, none is left in fstab, and openbao-selfcheck asserts /proc/swaps is empty at runtime.
no_new_privs="yes"

# File descriptors only. The `-l unlimited` that stood here existed to make mlock work even if the
# ambient capability failed to apply, and has nothing left to do.
rc_ulimit="-n 65536"

# Respawn forever, chosen rather than inherited.
#
# Alpine's /etc/rc.conf defaults are respawn_delay=2, respawn_max=5, respawn_period=1800: five crashes in
# thirty minutes and supervise-daemon gives up, leaving the store down until somebody notices. With one
# node and no quorum that is the whole availability story gone, and it is the same failure this service
# is enabled at boot to avoid -- a secret store that stays down after an unattended event is worse than
# one that starts too eagerly.
#
# `respawn_max=0` is unlimited. The delay goes to ten seconds so a genuinely fatal cause -- a
# configuration error the server refuses to load, as `disable_mlock = false` once was -- writes a
# readable log rather than a scrolling one.
respawn_delay=10
respawn_max=0

depend() {
	# `need`, not `after`, for both of the new ones, and that is the point of them existing. OpenBao
	# cannot run without the Raft volume mounted or without knowing its own private address, so those are
	# dependencies rather than orderings -- OpenRC starts them, refuses to start this if either fails, and
	# names the one that failed. What used to be here instead was a start_pre that did all three jobs and
	# reported every failure as "openbao failed to start".
	need net localmount metadata openbao-volume
	after tiny-cloud-main chronyd apparmor
}

reload() {
	ebegin "Reloading $name"
	supervise-daemon "$RC_SVCNAME" --signal HUP --pidfile "$pidfile"
	eend $? "Could not signal OpenBao; a rotated audit log would not be reopened"
}

start_pre() {
	# The TLS gate. Equivalent to ConditionPathExists= on the systemd unit: refuse to start rather than
	# restart-loop against material the operator has not installed yet. Returning 1 here makes OpenRC
	# report a clean failure with this message, which is what the operator needs to see on first boot.
	#
	# ca.crt is gated with the other two because openbao.hcl names it as tls_client_ca_file: without it
	# the server does not fail this check and then refuses to load, which reads as a configuration bug
	# rather than as a missing file.
	if [ ! -f /etc/openbao/tls/server.crt ] || [ ! -f /etc/openbao/tls/server.key ] ||
		[ ! -f /etc/openbao/tls/ca.crt ]; then
		eerror "No TLS material in /etc/openbao/tls."
		eerror "Generate it with stack's scripts/generate-openbao-tls <node-private-address>,"
		eerror "copy server.crt, server.key and ca.crt here, then start again."
		return 1
	fi

	# Ownership and modes applied here rather than left to the operator's `scp` and a README step.
	#
	# root:openbao, not 65532:65532. The AppArmor profile attaches to /usr/sbin/bao, so it confines the
	# CLI an operator types as well as the server, and it grants no capability -- which meant a directory
	# owned by 65532 was unreadable to a confined root and every `bao` command on the node failed on its
	# own CA file. See image/setup.sh for the full account. The server reads the key through the group.
	#
	# The key is 0640 and the certificates 0644, which is also why this is not a blanket chmod: a
	# world-readable private key is the one mistake here that would not announce itself.
	chown root:openbao /etc/openbao/tls/server.crt /etc/openbao/tls/server.key /etc/openbao/tls/ca.crt
	chmod 0640 /etc/openbao/tls/server.key
	chmod 0644 /etc/openbao/tls/server.crt /etc/openbao/tls/ca.crt

	# The Raft volume and the metadata read used to live here. Both are now services of their own --
	# /etc/init.d/openbao-volume and /etc/init.d/metadata -- declared with `need` in depend() above, so a
	# failure in either is reported against the thing that failed rather than as "openbao failed to start".
	#
	# This directory is not on the Raft volume, so it is this service's to create.
	install -d -o 65532 -g 65532 -m 0700 /var/log/openbao

	# The address clients dial. Not templated into the image, because it is this node's own private address
	# and the image is built long before any node exists. The private interface is deliberate: the firewall
	# admits 8200 only from tagged Droplets and the cluster pod ranges, so the public address is not a path
	# anything can use.
	#
	# Read from the cache the metadata service wrote, with no fetch and no retry here. A Droplet created
	# without VPC networking has no private address at all, which is why `metadata` succeeds without one and
	# this is where it becomes an error.
	address="$(cat /run/metadata/private-address 2>/dev/null || true)"
	if [ -z "$address" ]; then
		eerror "This node has no private address in the metadata service."
		eerror "OpenBao advertises one to its clients and cannot start without it; a Droplet created"
		eerror "without VPC networking cannot serve this cluster."
		return 1
	fi
	export BAO_API_ADDR="https://${address}:8200"
	export BAO_CLUSTER_ADDR="https://${address}:8201"
}
