#!/sbin/openrc-run
# shellcheck shell=sh
# shellcheck disable=SC2034  # openrc-run reads these variables out of this file; nothing here uses
# them directly, so shellcheck cannot see the consumer.
# OpenBao, supervised and confined.
#
# This replaces the systemd unit in stack/infrastructure/platform/cloud-init.yaml.tftpl. Every guard in
# that unit is reproduced here, because each one was added in response to something that actually went
# wrong; where the mechanism differs, the comment says so.

name="OpenBao"
description="OpenBao secret control plane"

command="/usr/sbin/bao"
# Two directories rather than one file. `-config` takes a directory and loads every .hcl in it in
# alphabetical order, and it may be given more than once -- so the image ships its fragments, the
# operator adds fragments beside it, and start_pre() writes user_data into the second directory.
#
# /run is loaded last, and that is the point: it is tmpfs, so a fragment derived from user_data is
# rebuilt at every start and can never be a stale file surviving a change nobody remembers making.
command_args="server -config=/etc/openbao/config.d -config=/run/openbao/config.d"
command_user="openbao:openbao"

supervisor="supervise-daemon"
supervise_daemon_args="--stdout /var/log/openbao/stdout.log --stderr /var/log/openbao/stderr.log"
# OpenRC's own default for a supervise-daemon service, written out rather than inherited because
# reload() below reads it and a silently different path would mean a rotated audit log never reopened.
pidfile="/run/supervise-${RC_SVCNAME}.pid"

# SIGHUP, which is how a rotated audit log gets reopened. Upstream: "Sending a SIGHUP to the OpenBao
# process will cause `file` audit devices to close and re-open their underlying file." Without this,
# /usr/local/sbin/openbao-rotate-logs renames audit.log and OpenBao keeps writing to the renamed inode --
# rotation that does not rotate, losing audit records with nothing to say so.
#
# OpenBao treats SIGHUP as a configuration reload, so this also picks up replaced TLS material without a
# restart. A reload that cannot be applied is logged and the server keeps running on what it had.
extra_started_commands="reload"

# No capabilities at all, deliberately, and the history is worth keeping because it was wrong twice.
#
# This line used to read `capabilities="^cap_ipc_lock"` -- cap_iab(3) notation putting CAP_IPC_LOCK in
# the ambient set, so it would survive the drop to uid 65532 and the exec into a non-root process. That
# mechanism works exactly as documented: a Droplet running it showed `CapAmb: 0000000000004000`.
#
# It bought nothing. **OpenBao 2.x has dropped mlock support outright.** Starting it with
# `disable_mlock = false` is a fatal configuration error in so many words:
#
#   OpenBao has dropped support for mlock. Please remove the line "disable_mlock" = false
#   from your config and disable or encrypt swap instead.
#
# So the capability was delivered to a process containing no code that could use it, and `VmLck` stayed
# at 0 on a node where every part of the grant had succeeded. Handing a long-lived network service the
# ability to lock unlimited memory -- a denial-of-service primitive -- in exchange for nothing is a
# straight loss, so it is gone.
#
# Upstream's own replacement guidance is "disable or encrypt swap", which image/setup.sh does: no swap
# is configured, none is left in fstab, and openbao-selfcheck asserts /proc/swaps is empty at runtime.
no_new_privs="yes"

# File descriptors only. The `-l unlimited` that stood here existed to make mlock work even if the
# ambient capability failed to apply, and has nothing left to do.
rc_ulimit="-n 65536"

# Respawn forever, chosen rather than inherited.
#
# Alpine's /etc/rc.conf defaults are respawn_delay=2, respawn_max=5, respawn_period=1800: five crashes in
# thirty minutes and supervise-daemon gives up, leaving the store down until somebody notices. With one
# node and no quorum that is the whole availability story gone, and it is the same failure this service
# is enabled at boot to avoid -- a secret store that stays down after an unattended event is worse than
# one that starts too eagerly.
#
# `respawn_max=0` is unlimited. The delay goes to ten seconds so a genuinely fatal cause -- a
# configuration error the server refuses to load, as `disable_mlock = false` once was -- writes a
# readable log rather than a scrolling one.
respawn_delay=10
respawn_max=0

depend() {
	# `need`, not `after`, for both of the new ones, and that is the point of them existing. OpenBao
	# cannot run without the Raft volume mounted or without knowing its own private address, so those are
	# dependencies rather than orderings -- OpenRC starts them, refuses to start this if either fails, and
	# names the one that failed. What used to be here instead was a start_pre that did all three jobs and
	# reported every failure as "openbao failed to start".
	need net localmount metadata openbao-volume
	after tiny-cloud-main chronyd apparmor
}

reload() {
	ebegin "Reloading $name"
	supervise-daemon "$RC_SVCNAME" --signal HUP --pidfile "$pidfile"
	eend $? "Could not signal OpenBao; a rotated audit log would not be reopened"
}

# Every value a parameter is given across both configuration directories, one per line.
#
# The `^[[:space:]]*` anchor is what keeps a commented-out example from counting as configuration, which
# matters here because the fragments this image ships document their alternatives in comments -- the
# ACME note in 10-listener.hcl names tls_cert_file in prose directly above the real one.
config_values() {
	grep -rhE "^[[:space:]]*$1[[:space:]]*=" \
		/etc/openbao/config.d /run/openbao/config.d 2>/dev/null |
		sed -e 's/.*=[[:space:]]*//' -e 's/^"//' -e 's/".*$//'
}

start_pre() {
	# DigitalOcean user_data, turned into a configuration fragment.
	#
	# Done FIRST, before the TLS gate below, and the order is load-bearing rather than tidy: user_data
	# may carry its own `listener`, so what TLS material this node needs is not known until it has been
	# read. Gating before this point is how the gate came to be hard-coded to one path.
	#
	# /run is tmpfs, so this directory is rebuilt from scratch at every start and a fragment cannot
	# outlive the user_data that produced it. The alternative -- writing into /etc -- leaves a stale file
	# behind the moment user_data shrinks, which is the failure that is impossible to see in a diff.
	install -d -o root -g openbao -m 0750 /run/openbao/config.d
	rm -f /run/openbao/config.d/50-user-data.hcl
	if [ -s /run/metadata/user-data ]; then
		# A sentinel first line, so that a Droplet created with user_data meant for something else is
		# ignored rather than fatal. Without it, any unrelated document -- a cloud-config someone pasted
		# out of habit -- becomes a configuration parse error that stops the secret store from starting.
		if [ "$(head -n1 /run/metadata/user-data)" = "#openbao-config" ]; then
			# ASCII only, checked rather than assumed. DigitalOcean does not deliver user_data as UTF-8:
			# a single multi-byte character is enough to corrupt the document in transit, and the
			# em-dash that did it last time was in a comment. Caught here, it names the cause; left to
			# OpenBao, it is a parse error pointing at a line that looks fine.
			if [ -n "$(tr -d '\000-\177' < /run/metadata/user-data)" ]; then
				eerror "user_data contains non-ASCII characters, which DigitalOcean does not deliver"
				eerror "intact. Rewrite it in ASCII -- including its comments -- and rebuild the Droplet."
				return 1
			fi
			cp /run/metadata/user-data /run/openbao/config.d/50-user-data.hcl
			chown root:openbao /run/openbao/config.d/50-user-data.hcl
			chmod 0640 /run/openbao/config.d/50-user-data.hcl
			einfo "Loaded user_data as a configuration fragment"
		else
			einfo "user_data is not #openbao-config; ignoring it"
		fi
	fi

	# The TLS gate, against the certificate the CONFIGURATION asks for rather than against the one this
	# image happens to ship.
	#
	# It used to test three literal paths under /var/lib/openbao/tls, which was correct for the default
	# and wrong for everything else: README.md invites replacing 10-listener.hcl with an ACME listener,
	# and OpenBao supports `tls_disable` for a node behind a terminating proxy -- and under the old gate
	# both of those refused to start, naming files the operator had deliberately not created. An image
	# other people boot cannot gate on its own defaults.
	#
	# So the rule is: whatever certificate, key and CA the loaded fragments name must exist. That keeps
	# the whole point of the gate -- refuse to start rather than restart-loop against material nobody
	# installed -- while making it true of the configuration in force. It is also strictly stronger for
	# an operator who moved the files, which previously passed the gate and then failed inside OpenBao.
	#
	# No tls_cert_file anywhere is not an error. It means ACME or tls_disable, both of which are
	# deliberate choices with nothing for this to check; openbao-selfcheck reports which is in effect.
	missing=""
	for tls_file in $(config_values tls_cert_file) $(config_values tls_key_file) \
		$(config_values tls_client_ca_file); do
		[ -f "$tls_file" ] || missing="$missing $tls_file"
	done
	if [ -n "$missing" ]; then
		eerror "The listener names TLS material that is not there:"
		for tls_file in $missing; do eerror "    $tls_file"; done
		eerror "Generate it with stack's scripts/generate-openbao-tls <openbao-dns-name>, copy"
		eerror "server.crt, server.key and ca.crt to /var/lib/openbao/tls, then start again."
		eerror "That directory is on the attached volume, so it only needs doing once per volume --"
		eerror "a replacement Droplet reattaches it and this gate is already satisfied."
		return 1
	fi

	# Ownership and modes applied here rather than left to the operator's `scp` and a README step.
	#
	# root:openbao, not 65532:65532. The AppArmor profile attaches to /usr/sbin/bao, so it confines the
	# CLI an operator types as well as the server, and it grants no capability -- which meant a directory
	# owned by 65532 was unreadable to a confined root and every `bao` command on the node failed on its
	# own CA file. See image/setup.sh for the full account. The server reads the key through the group.
	#
	# The key is 0640 and the certificates 0644, which is also why this is not a blanket chmod: a
	# world-readable private key is the one mistake here that would not announce itself.
	#
	# Scoped to /var/lib/openbao/tls, which is the directory this image creates and documents. A
	# certificate the operator put somewhere else is theirs, and silently rewriting the ownership of a
	# path we do not manage is how a service breaks something that was working.
	for tls_file in $(config_values tls_cert_file) $(config_values tls_client_ca_file); do
		case "$tls_file" in /var/lib/openbao/tls/*)
			chown root:openbao "$tls_file"
			chmod 0644 "$tls_file"
			;;
		esac
	done
	for tls_file in $(config_values tls_key_file); do
		case "$tls_file" in /var/lib/openbao/tls/*)
			chown root:openbao "$tls_file"
			chmod 0640 "$tls_file"
			;;
		esac
	done

	# The seal key, if this node has been given one. Absent is not an error: with no `seal` stanza
	# anywhere OpenBao uses Shamir, which is the image's default and needs no file.
	#
	# root:openbao 0640, for the same reason as server.key and applied here rather than left to an
	# operator's `scp` -- this is the one file on the node that decrypts the Raft store, and a
	# world-readable copy of it is the mistake that would not announce itself.
	if [ -f /etc/openbao/seal/key ]; then
		chown root:openbao /etc/openbao/seal/key
		chmod 0640 /etc/openbao/seal/key

		# A trailing newline in this file is a fatal configuration error, and the message OpenBao gives
		# for it names neither the file nor the cause:
		#
		#   Error configuring seal "static": unknown encoding for AES-256 key: must be either a raw,
		#   hex, or base64-encoded
		#
		# `openssl rand -base64 32 > key` produces exactly that, which makes this the most likely way to
		# get the file wrong on the first try. Measured against OpenBao 2.6.1. Refused rather than
		# trimmed, because silently rewriting an operator's key material is worse than saying so.
		#
		# The test reads oddly and is correct: command substitution strips trailing newlines, so a file
		# ending in one yields an empty string here and a file ending in a real character does not.
		if [ -z "$(tail -c1 /etc/openbao/seal/key)" ]; then
			eerror "/etc/openbao/seal/key ends with a newline, which OpenBao rejects as an unknown"
			eerror "key encoding. Write it without one:"
			eerror "  printf %s \"\$key\" > /etc/openbao/seal/key"
			return 1
		fi
	fi

	# The Raft volume and the metadata read used to live here. Both are now services of their own --
	# /etc/init.d/openbao-volume and /etc/init.d/metadata -- declared with `need` in depend() above, so a
	# failure in either is reported against the thing that failed rather than as "openbao failed to start".
	#
	# This directory is not on the Raft volume, so it is this service's to create.
	install -d -o 65532 -g 65532 -m 0700 /var/log/openbao

	# The address clients dial. Not templated into the image, because it is this node's own private address
	# and the image is built long before any node exists. The private interface is deliberate: the firewall
	# admits 8200 only from tagged Droplets and the cluster pod ranges, so the public address is not a path
	# anything can use.
	#
	# Read from the cache the metadata service wrote, with no fetch and no retry here. A Droplet created
	# without VPC networking has no private address at all, which is why `metadata` succeeds without one and
	# this is where it becomes an error.
	address="$(cat /run/metadata/private-address 2>/dev/null || true)"
	if [ -z "$address" ]; then
		eerror "This node has no private address in the metadata service."
		eerror "OpenBao advertises one to its clients and cannot start without it; a Droplet created"
		eerror "without VPC networking cannot serve this cluster."
		return 1
	fi
	export BAO_API_ADDR="https://${address}:8200"
	export BAO_CLUSTER_ADDR="https://${address}:8201"
}
