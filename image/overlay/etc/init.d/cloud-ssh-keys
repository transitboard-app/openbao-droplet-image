#!/sbin/openrc-run
# shellcheck shell=sh
# shellcheck disable=SC2034  # openrc-run reads these variables out of this file.
# Installs the operator's SSH key from the DigitalOcean metadata service.
#
# This exists because tiny-cloud could not be relied on for it, and being unable to log in to the node
# holding every production credential is the worst failure this image has. tiny-cloud's DigitalOcean
# module carries a literal "TODO: flesh out networking" and unsets every network metadata variable, its
# set_ssh_keys writes nothing at all when CLOUD_USER is unset -- which is how it ships -- and when it
# does fail it logs "no ssh key found" and lets the boot continue to a login prompt nobody can use.
#
# So this does the one job directly, and treats failure as a failure. It is idempotent and additive: an
# operator key added by hand is never removed.
#
# There is no network code here and no retry loop. Both moved to /etc/init.d/metadata, which is the one
# place that waits for the metadata service and caches what it returns -- see that file for why the wait
# cannot be expressed as an OpenRC dependency, and for what having two copies of it cost.

description="Install SSH keys from the cloud metadata service"

cache=/run/metadata

depend() {
	need metadata
	before sshd
	after tiny-cloud-main
}

start() {
	keys_dir=/root/.ssh
	keys_file="$keys_dir/authorized_keys"

	ebegin "Installing SSH keys for root"
	keys="$(cat "$cache/public-keys" 2>/dev/null || true)"

	# The fallback that makes a node recoverable when DigitalOcean has no keys registered for it. Both
	# documents come from the same service, so this is a second field rather than a second mechanism --
	# but an operator can paste a key into user-data when the Droplet was created without one.
	if [ -z "$keys" ]; then
		ewarn "No keys under public-keys; trying user-data"
		# sk- covers the FIDO key types, sk-ssh-ed25519@openssh.com and sk-ecdsa-sha2-nistp256@openssh.com.
		# Without them this fallback silently matched nothing for an operator using a hardware key, on the
		# exact path that exists because the node is otherwise unreachable.
		keys="$(grep -E '^(ssh-|ecdsa-|sk-ssh-|sk-ecdsa-)' "$cache/user-data" 2>/dev/null || true)"
	fi

	if [ -z "$keys" ]; then
		eend 1 "No SSH keys available; this node will be unreachable"
		return 1
	fi

	install -d -o root -g root -m 0700 "$keys_dir"
	touch "$keys_file"
	chown root:root "$keys_file"
	chmod 0600 "$keys_file"

	# Additive and idempotent. A key installed by an operator during recovery outlives a reboot, and a
	# key already present is not duplicated.
	echo "$keys" | while IFS= read -r key; do
		[ -n "$key" ] || continue
		grep -qxF "$key" "$keys_file" || echo "$key" >> "$keys_file"
	done

	eend 0
	einfo "Installed $(grep -c . "$keys_file") key(s) for root"
}
