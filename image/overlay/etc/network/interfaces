# DigitalOcean serves DHCP on both interfaces for custom images, so neither needs an address from the
# metadata service. What they DO need is for something in OpenRC to bring them up.
#
# alpine-make-vm-image writes an eth0 stanza but enables no networking service, so `net` is never
# provided: `need net` goes unsatisfied and every service that declares it -- tiny-cloud-main, and our own
# cloud-ssh-keys -- silently never runs. The Droplet still reaches the internet, because tiny-cloud's
# set_ephemeral_network runs udhcpc directly outside OpenRC, and sshd still starts because it declares
# `after net` rather than `need net`. The result is a machine that boots, answers on port 22, and has no
# authorized_keys, with nothing in the boot log naming the cause.
#
# setup.sh creates the net.lo / net.eth0 / net.eth1 services that make this file effective.

auto lo
iface lo inet loopback

# The public interface. DigitalOcean's DHCP for custom images runs on port 67, so an outbound UDP rule
# for it is required if a firewall is ever applied to this Droplet.
auto eth0
iface eth0 inet dhcp

# The VPC interface, and the one this appliance actually exists to serve on: OpenBao advertises its
# private address, the Agent sidecars dial it, and the firewall admits 8200 from nowhere else. Without
# this stanza the Droplet has a private address in DigitalOcean's records and no private address in the
# kernel.
#
# `post-up true` keeps a Droplet created without VPC networking from failing its boot on a missing
# interface -- there is nothing to configure, and that is not an error worth stopping for.
auto eth1
iface eth1 inet dhcp
	post-up true

post-up /etc/network/if-post-up.d/*
post-down /etc/network/if-post-down.d/*
