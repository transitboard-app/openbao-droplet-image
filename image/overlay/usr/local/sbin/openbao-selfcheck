#!/bin/sh
# Asserts that the properties this image claims are true of the running system.
#
# Every check here exists because the corresponding configuration can be present and ineffective. The
# kernel can carry an AppArmor profile that was never enforced; the init script can request an ambient
# capability the kernel declined to grant; mlock can be configured and silently not held. Configuration
# is a claim, and this is the part that checks it.
#
# Exits non-zero on the first failure so it can gate anything that depends on the node being sound.
set -eu

fail=0
check() {
	if eval "$2" >/dev/null 2>&1; then
		printf '  ok    %s\n' "$1"
	else
		printf '  FAIL  %s\n' "$1"
		fail=1
	fi
}

# securityfs carries AppArmor's state and is not always mounted by default. Mounting it here rather
# than depending on it keeps this script runnable on a node where something else did not.
[ -d /sys/kernel/security/apparmor ] || mount -t securityfs securityfs /sys/kernel/security 2>/dev/null || true

echo "AppArmor"
# Read from the kernel directly rather than through aa-status. That tool lives in apparmor-utils, which
# is not installed -- and asking the kernel is the better check anyway: it reports what is actually
# enforced rather than what a userspace tool believes was loaded.
check "enabled in the kernel"        '[ "$(cat /sys/module/apparmor/parameters/enabled 2>/dev/null)" = "Y" ]'
check "openbao profile loaded"       'grep -q "^openbao " /sys/kernel/security/apparmor/profiles'
check "profile is enforcing"         'grep -q "^openbao (enforce)" /sys/kernel/security/apparmor/profiles'

echo "OpenBao process"
# Found by walking /proc rather than with pgrep, because busybox's `pgrep -x bao` returns nothing on
# this image for a process whose /proc/<pid>/comm is exactly `bao`, while plain `pgrep bao` finds it.
#
# That is worth more than a footnote. This block used to begin `pid="$(pgrep -x bao)"`, and on a live
# Droplet serving requests on 8200 it reported one failure -- "running" -- and then SKIPPED every check
# underneath it, because they were all guarded on a non-empty $pid. Silently skipping the confinement
# and privilege assertions is the exact failure this script exists to prevent, so the guard below now
# says so out loud instead of falling through quietly.
pid=""
for proc in /proc/[0-9]*; do
	[ -r "$proc/comm" ] || continue
	read -r comm < "$proc/comm" || continue
	[ "$comm" = "bao" ] || continue
	pid="${proc#/proc/}"
	break
done

# First boot is not a failure, and saying so is what keeps this script worth reading. The service refuses
# to start until an operator has installed TLS material, so on a node that has not had it yet OpenBao is
# correctly absent -- and a check that reports the intended first-boot state as a fault is one people
# learn to skip.
configured=0
if [ -f /etc/openbao/tls/server.crt ]; then
	configured=1
fi

if [ "$configured" = 0 ]; then
	echo "  ....  no TLS material in /etc/openbao/tls, so OpenBao is correctly not running yet"
	echo "        install it and start the service; README.md has the procedure"
else
	check "running"                   '[ -n "'"$pid"'" ]'
fi

if [ -n "$pid" ]; then
	# No capabilities, which is the correct assertion now that there is nothing to grant one for.
	# OpenBao 2.x dropped mlock support, so the CAP_IPC_LOCK this once required -- and the
	# `memory locked (VmLck > 0)` check that went with it -- are gone from the init script and from
	# here. See /etc/init.d/openbao for the error message upstream emits and why the grant was removed
	# rather than left in place harmlessly.
	check "holds no capabilities"     '[ "$(awk "/^CapEff:/ {print \$2}" /proc/'"$pid"'/status)" = "0000000000000000" ]'
	check "runs as uid 65532"         '[ "$(awk "/^Uid:/ {print \$2}" /proc/'"$pid"'/status)" = "65532" ]'
	check "no_new_privs set"          '[ "$(awk "/^NoNewPrivs:/ {print \$2}" /proc/'"$pid"'/status)" = "1" ]'
	# The confinement label of this specific process, which is the question the profile existing does
	# not answer: a loaded profile that never attached leaves OpenBao unconfined with nothing to say so.
	check "confined by openbao profile" 'grep -q "^openbao (enforce)" /proc/'"$pid"'/attr/current'
elif [ "$configured" = 1 ]; then
	echo "  ....  OpenBao is not running, so its privilege and confinement checks did not run"
fi

echo "Configuration"
# Which fragments are actually loaded, reported rather than assumed. The service reads two directories
# and the second is tmpfs, so "what is this server configured with" is not answerable from /etc alone --
# and a user_data fragment that was silently skipped for the wrong reason is invisible otherwise.
etc_fragments="$(find /etc/openbao/config.d -maxdepth 1 -name '*.hcl' 2>/dev/null | wc -l | tr -d ' ')"
check "storage fragment present"     'test -f /etc/openbao/config.d/00-storage.hcl'
check "listener fragment present"    'test -f /etc/openbao/config.d/10-listener.hcl'
echo "  ....  $etc_fragments fragment(s) in /etc/openbao/config.d"
if [ -f /run/openbao/config.d/50-user-data.hcl ]; then
	echo "  ....  user_data loaded as a fragment"
elif [ -s /run/metadata/user-data ]; then
	# Not a failure: user_data without the sentinel is meant for something else and is correctly ignored.
	# Said out loud anyway, because "I put it in user_data and nothing happened" is otherwise unanswerable
	# without reading the init script.
	echo "  ....  user_data present but not #openbao-config, so it was ignored"
fi

echo "Seal"
# No seal is the image's default and is not a fault: OpenBao then uses Shamir, whose key material never
# touches this node at all. That is the stronger arrangement at rest and the weaker one for availability,
# and choosing between them is the operator's call rather than the image's.
#
# What IS a fault is the two of them disagreeing, which is the one state here nothing else catches. A
# stanza naming a key that is absent stops the server, loudly, at start_pre. A key present that no stanza
# names does the opposite: the server starts, unseals with Shamir, works perfectly, and leaves the key
# that was supposed to be protecting it sitting unused on the disk. Every other signal on the node looks
# healthy.
seal_declared=0
if grep -rqE '^[[:space:]]*seal[[:space:]]' /etc/openbao/config.d/ /run/openbao/config.d/ 2>/dev/null; then
	seal_declared=1
fi

if [ -f /etc/openbao/seal/key ]; then
	check "seal key is root-owned"   '[ "$(stat -c %u /etc/openbao/seal/key)" = 0 ]'
	check "seal key group is 65532"  '[ "$(stat -c %g /etc/openbao/seal/key)" = 65532 ]'
	check "seal key is 0640"         '[ "$(stat -c %a /etc/openbao/seal/key)" = 640 ]'
	# The one way to get this file wrong that OpenBao reports as an unknown key encoding rather than as
	# a malformed file. `openssl rand -base64 32 > key` produces it. See /etc/init.d/openbao.
	check "seal key has no trailing newline" '[ -n "$(tail -c1 /etc/openbao/seal/key)" ]'
	check "a seal stanza uses the key"       '[ "'"$seal_declared"'" = 1 ]'
	[ "$seal_declared" = 1 ] || echo "        a key is installed but no fragment declares a seal, so it" \
		"is ignored and this node is unsealing with Shamir shares"
elif [ "$seal_declared" = 1 ]; then
	# Legitimate: a transit or KMS seal holds no key file on the node, which is the point of it.
	echo "  ....  a seal is declared with no key at /etc/openbao/seal/key -- transit or KMS"
else
	echo "  ....  no seal declared; this node unseals with Shamir shares"
fi

echo "Host"
# Load-bearing rather than hygiene. With mlock gone from OpenBao 2.x, keeping decrypted secret material
# out of swap is entirely a property of there being no swap -- this is upstream's own guidance ("disable
# or encrypt swap instead") and the only thing standing where mlock used to.
check "no swap active"               '[ "$(awk "NR>1" /proc/swaps | wc -l)" -eq 0 ]'
check "core dumps discarded"         'grep -q "/bin/false" /proc/sys/kernel/core_pattern'
check "ptrace_scope is 3"            '[ "$(cat /proc/sys/kernel/yama/ptrace_scope)" = "3" ]'
# Mounted by the service's start_pre, so it is only expected once the service has been able to start.
if [ "$configured" = 1 ]; then
	check "raft volume mounted"      'mountpoint -q /var/lib/openbao'
fi
check "no package manager"           '! command -v apk'
check "no shell for openbao user"    'grep "^openbao:" /etc/passwd | grep -q nologin'

echo "AppArmor denials since boot"
# Scoped to the server, deliberately, and this is the difference between a check that gets read and one
# that does not.
#
# The profile attaches to /usr/sbin/bao, so it confines the CLI an operator types as well as the server:
# every `bao` command run by hand appears here under profile="openbao". This section used to grep all of
# dmesg, so using the CLI once turned a fully green node into one reporting "the profile is too tight
# somewhere" for the rest of its uptime -- a normal operation permanently failing the check.
#
# So: denials against the running server are a failure, and everything else is counted and named. Nothing
# is hidden, and the line an operator has to act on is the one that says FAIL.
denials="$(dmesg 2>/dev/null | grep 'apparmor="DENIED"' || true)"
server_denials=""
if [ -n "$pid" ] && [ -n "$denials" ]; then
	server_denials="$(printf '%s\n' "$denials" | grep -E "pid=$pid( |\$)" || true)"
fi
other="$(printf '%s\n' "$denials" | grep -cE 'apparmor="DENIED"' || true)"

if [ -n "$server_denials" ]; then
	echo "  FAIL  the profile is too tight for the server (pid $pid):"
	printf '%s\n' "$server_denials" | tail -10 | sed 's/^/    /'
	fail=1
elif [ "$other" -gt 0 ]; then
	# Almost always the operator's own CLI, which is confined by the same profile and denied things the
	# server never asks for. Shown rather than swallowed, because a denial from anything else matters.
	echo "  none against the server; $other denial(s) from other processes under this profile:"
	printf '%s\n' "$denials" | tail -3 | sed 's/^/    /'
else
	echo "  none"
fi

exit "$fail"
