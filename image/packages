# Everything installed into the appliance beyond `alpine-base` and the `linux-virt` kernel.
#
# The rule for this file: a package earns its place by being needed to boot on DigitalOcean, to reach
# the node, or to run and confine OpenBao. Nothing here is for convenience -- there is no shell to be
# convenient in and no package manager to add one with once the image is built.
#
# Blank lines and # comments are stripped by the build:image task in mise.linux-x64.toml.

# Break-glass access, and the transport for both of stack's tunnels. `openbao:tunnel` and `db:tunnel`
# are `ssh -L` port forwards through this node, so sshd is load-bearing operations tooling rather than
# a convenience -- see the AllowTcpForwarding note in overlay/etc/ssh/sshd_config.d/10-appliance.conf.
#
# The SERVER, not the `openssh` meta-package, and the difference is 2.2 MiB of client the appliance
# never runs. `openssh` pulls in openssh-client-default: ssh, scp, sftp, ssh-add, ssh-agent,
# ssh-keyscan, ssh-copy-id and ssh-pkcs11-helper. Every SSH session this node takes part in is inbound
# -- the tunnels are `ssh -L` from an operator's machine, and the client runs there -- so the whole
# suite is surface with no caller. Dropping it also orphans libedit, which only `sftp` linked.
#
# openssh-keygen comes as a dependency and is required, not incidental: sshd's init script runs
# `ssh-keygen -A` on first boot, which is what keeps this image from shipping a host key every Droplet
# built from it would share.
openssh-server
# `scp` is the documented way TLS material reaches the node, and OpenSSH 9 and later run scp over the
# SFTP protocol rather than the legacy rcp one. Without this subpackage the server has no sftp
# subsystem and the first-boot procedure in README.md fails with a message about the subsystem request,
# which reads as an sshd misconfiguration rather than a missing file.
openssh-sftp-server

# DigitalOcean's metadata contract: SSH keys, hostname, networking, root filesystem expansion.
# tiny-cloud rather than cloud-init, measured at 5 MiB against 62 MiB -- cloud-init drags in a whole
# Python runtime, which on this machine is both the largest single package and the largest interpreter
# an attacker could find already installed.
tiny-cloud-digitalocean
tiny-cloud-openrc

# Mandatory access control for the OpenBao process. See overlay/etc/apparmor.d/openbao, and the kernel
# command line in setup.sh without which none of it takes effect.
apparmor
apparmor-openrc
# The abstractions and tunables the profile includes. Not part of the `apparmor` package, and their
# absence is a parse error at boot rather than a missing feature. 668 KiB.
apparmor-profiles-abstractions
apparmor-profiles-tunables

# libcap-utils was here for getpcaps, "used by the boot-time self-check to prove OpenBao actually holds
# CAP_IPC_LOCK". That reason died twice over: the capability was removed when OpenBao 2.x turned out to
# have dropped mlock, and openbao-selfcheck reads CapEff out of /proc/<pid>/status with awk. Nothing in
# the image referenced getpcaps.
#
# What the package did put on the appliance is /usr/sbin/setcap and /usr/sbin/capsh -- a tool for granting
# file capabilities and a tool for manipulating capability sets -- on a machine whose entire premise is
# that nothing holds a capability. Removing it drops all four files, libcap.so.2 included.

# resize2fs and sfdisk, for growing the root filesystem into the Droplet's disk on first boot. The
# image is 1 GiB and the smallest Droplet has 25 GiB.
#
# resize2fs is in `-extra` rather than in base e2fsprogs -- checked against the v3.24 package, because
# the reverse is the obvious guess and it is wrong. The subpackage carries nineteen other tools with
# it, and image/setup.sh deletes the ones this appliance has no caller for. `debugfs` is the one that
# matters: it is a raw ext2/3/4 editor that reads and writes blocks directly, so on this host it is a
# way to read the Raft volume around every file permission on it.
e2fsprogs-extra
sfdisk

# The public trust store, for any TLS endpoint OpenBao dials that a public CA signed -- ACME's
# directory if a node uses it, and an external service with an ordinary certificate.
#
# **It is NOT what verifies a DigitalOcean managed database, and this entry used to say it was.**
# Measured against a real managed PostgreSQL 17: DigitalOcean signs those with a per-project private CA
# (`CN=<project-uuid> Project CA`), so `sslmode=verify-full` against this bundle fails with
# `x509: certificate signed by unknown authority`. The database secrets engine works perfectly once the
# project CA is on the node and the connection string names it:
#
#   doctl databases get-ca <id> > /etc/openbao/postgres-ca.crt   # root:openbao 0640
#   connection_url=...?sslmode=verify-full&sslrootcert=/etc/openbao/postgres-ca.crt
#
# It has to be under /etc/openbao, not /tmp: the AppArmor profile confines the CLI as well as the
# server and grants no read on /tmp, so `bao write ... @/tmp/ca.crt` is denied. See README.md.
ca-certificates

# Clock discipline. Not optional on this host specifically: every credential OpenBao issues is a
# time-bounded lease, and its own TLS handshakes fail on skew. A secret server with a drifting clock
# fails in ways that read as authentication bugs.
chrony

# `ip route replace`, which busybox's applet does not implement. stack's D20 fix writes one route per
# worker node onto this Droplet; without it, pods reach OpenBao and the replies are dropped.
#
# `-minimal`, which is the subpackage that owns /sbin/ip -- checked against the installed image, not
# assumed. The plain `iproute2` meta-package adds iproute2-tc, iproute2-ss, /sbin/bridge, /sbin/genl,
# /sbin/rtmon and libxtables on top of it, none of which anything here calls: `tc` is a traffic-shaping
# language, `bridge` and `genl` configure things this node does not have, and libxtables is linked only
# by tc. The `ip` binary is the same file either way, so `ip route replace` is unaffected.
iproute2-minimal
